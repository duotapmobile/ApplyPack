{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Optional ApplyPack read-only archive verifier identity for the existing archive and public-CA trust anchor. No bucket, key, database, network, paid CA, writer or deletion resources.",
  "Parameters": {
    "EnableArchiveVerifier": { "Type": "String", "AllowedValues": ["false", "true"], "Default": "false" },
    "ProductionTrustAnchorArn": { "Type": "String", "AllowedPattern": "^arn:aws:rolesanywhere:us-east-1:838445019912:trust-anchor/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
    "ArchiveKeyArn": { "Type": "String", "AllowedPattern": "^arn:aws:kms:us-east-1:838445019912:key/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
    "ApprovedQuoteSha256": { "Type": "String", "AllowedPattern": "^[a-f0-9]{64}$", "Description": "Digest of the separately approved consolidated quote; the parameter itself does not establish approval." },
    "ReleaseSha": { "Type": "String", "AllowedPattern": "^[a-f0-9]{40}$" }
  },
  "Rules": { "ExactProductionTarget": { "Assertions": [
    { "Assert": { "Fn::Equals": [{ "Ref": "AWS::AccountId" }, "838445019912"] }, "AssertDescription": "Only the reviewed account is allowed." },
    { "Assert": { "Fn::Equals": [{ "Ref": "AWS::Region" }, "us-east-1"] }, "AssertDescription": "Only the reviewed archive region is allowed." }
  ] } },
  "Conditions": { "ArchiveVerifierEnabled": { "Fn::Equals": [{ "Ref": "EnableArchiveVerifier" }, "true"] } },
  "Resources": {
    "ArchiveVerifierBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "applypack-production-archive-verifier-boundary", "Path": "/applypack/production/",
        "PolicyDocument": { "Version": "2012-10-17", "Statement": [
          { "Effect": "Allow", "Action": ["s3:ListBucketVersions"], "Resource": "arn:aws:s3:::applypack-production-protected-recovery-838445019912",
            "Condition": { "StringEquals": { "s3:prefix": ["objects/", "manifests/", "database/manifests/", "database/dumps/", "database/roles/"] } } },
          { "Effect": "Allow", "Action": ["s3:GetObjectVersion"], "Resource": [
            "arn:aws:s3:::applypack-production-protected-recovery-838445019912/objects/customer-source-documents/*",
            "arn:aws:s3:::applypack-production-protected-recovery-838445019912/objects/customer-deliveries/*",
            "arn:aws:s3:::applypack-production-protected-recovery-838445019912/objects/operator-drafts/*",
            "arn:aws:s3:::applypack-production-protected-recovery-838445019912/objects/operator-render-previews/*",
            "arn:aws:s3:::applypack-production-protected-recovery-838445019912/manifests/*",
            "arn:aws:s3:::applypack-production-protected-recovery-838445019912/database/manifests/*",
            "arn:aws:s3:::applypack-production-protected-recovery-838445019912/database/dumps/*",
            "arn:aws:s3:::applypack-production-protected-recovery-838445019912/database/roles/*"
          ] },
          { "Effect": "Allow", "Action": ["kms:Decrypt"], "Resource": { "Ref": "ArchiveKeyArn" },
            "Condition": { "StringEquals": { "kms:ViaService": "s3.us-east-1.amazonaws.com", "kms:CallerAccount": "838445019912" },
              "StringLike": { "kms:EncryptionContext:aws:s3:arn": [
                "arn:aws:s3:::applypack-production-protected-recovery-838445019912/objects/customer-source-documents/*",
                "arn:aws:s3:::applypack-production-protected-recovery-838445019912/objects/customer-deliveries/*",
                "arn:aws:s3:::applypack-production-protected-recovery-838445019912/objects/operator-drafts/*",
                "arn:aws:s3:::applypack-production-protected-recovery-838445019912/objects/operator-render-previews/*",
                "arn:aws:s3:::applypack-production-protected-recovery-838445019912/manifests/*",
                "arn:aws:s3:::applypack-production-protected-recovery-838445019912/database/manifests/*",
                "arn:aws:s3:::applypack-production-protected-recovery-838445019912/database/dumps/*",
                "arn:aws:s3:::applypack-production-protected-recovery-838445019912/database/roles/*"
              ] } }
          }
        ] }
      }
    },
    "ArchiveVerifierRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "applypack-production-archive-verifier", "Path": "/applypack/production/", "MaxSessionDuration": 3600,
        "PermissionsBoundary": { "Ref": "ArchiveVerifierBoundary" }, "ManagedPolicyArns": [{ "Ref": "ArchiveVerifierBoundary" }],
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "rolesanywhere.amazonaws.com" },
          "Action": ["sts:AssumeRole", "sts:TagSession", "sts:SetSourceIdentity"], "Condition": { "StringEquals": {
            "aws:SourceAccount": "838445019912", "aws:PrincipalTag/x509Subject/CN": "applypack-production-archive-verifier"
          }, "ArnEquals": { "aws:SourceArn": { "Ref": "ProductionTrustAnchorArn" } } }
        }] },
        "Tags": [{ "Key": "Application", "Value": "ApplyPack" }, { "Key": "Environment", "Value": "production" },
          { "Key": "ReleaseSha", "Value": { "Ref": "ReleaseSha" } }, { "Key": "ApprovedQuoteSha256", "Value": { "Ref": "ApprovedQuoteSha256" } }]
      }
    },
    "ArchiveVerifierProfile": {
      "Type": "AWS::RolesAnywhere::Profile",
      "Properties": { "Name": "applypack-production-archive-verifier", "Enabled": { "Fn::If": ["ArchiveVerifierEnabled", true, false] },
        "DurationSeconds": 3600, "AcceptRoleSessionName": false, "RoleArns": [{ "Fn::GetAtt": ["ArchiveVerifierRole", "Arn"] }],
        "Tags": [{ "Key": "Application", "Value": "ApplyPack" }, { "Key": "Environment", "Value": "production" }]
      }
    }
  },
  "Outputs": {
    "ArchiveVerifierRoleArn": { "Value": { "Fn::GetAtt": ["ArchiveVerifierRole", "Arn"] } },
    "ArchiveVerifierProfileArn": { "Value": { "Fn::GetAtt": ["ArchiveVerifierProfile", "ProfileArn"] } }
  }
}
