{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Optional ApplyPack database-export writer for the existing protected archive. Three identity resources only; no database, bucket, key, deletion, network or paid certificate authority.",
  "Parameters": {
    "EnableDatabaseWriter": { "Type": "String", "AllowedValues": ["false", "true"], "Default": "false" },
    "ProductionTrustAnchorArn": { "Type": "String", "AllowedPattern": "^arn:aws:rolesanywhere:us-east-1:838445019912:trust-anchor/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
    "ArchiveKeyArn": { "Type": "String", "AllowedPattern": "^arn:aws:kms:us-east-1:838445019912:key/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$", "Description": "Provider-verified key of the existing protected archive; never the application encryption key." },
    "ApprovedQuoteSha256": { "Type": "String", "AllowedPattern": "^[a-f0-9]{64}$", "Description": "Digest of the owner-approved consolidated resource quote; a value alone is not evidence of approval." },
    "ReleaseSha": { "Type": "String", "AllowedPattern": "^[a-f0-9]{40}$" }
  },
  "Rules": {
    "ExactProductionTarget": { "Assertions": [
      { "Assert": { "Fn::Equals": [{ "Ref": "AWS::AccountId" }, "838445019912"] }, "AssertDescription": "Only the verified ApplyPack account is allowed." },
      { "Assert": { "Fn::Equals": [{ "Ref": "AWS::Region" }, "us-east-1"] }, "AssertDescription": "Only the reviewed archive region is allowed." }
    ] }
  },
  "Conditions": { "DatabaseWriterEnabled": { "Fn::Equals": [{ "Ref": "EnableDatabaseWriter" }, "true"] } },
  "Resources": {
    "DatabaseWriterBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "applypack-production-database-backup-writer-boundary", "Path": "/applypack/production/",
        "PolicyDocument": { "Version": "2012-10-17", "Statement": [
          { "Effect": "Allow", "Action": ["s3:PutObject"], "Resource": "arn:aws:s3:::applypack-production-protected-recovery-838445019912/database/*", "Condition": { "StringEquals": { "s3:x-amz-server-side-encryption": "aws:kms", "s3:x-amz-server-side-encryption-aws-kms-key-id": { "Ref": "ArchiveKeyArn" } } } },
          { "Effect": "Allow", "Action": ["s3:GetObjectVersion"], "Resource": "arn:aws:s3:::applypack-production-protected-recovery-838445019912/manifests/*" },
          { "Effect": "Allow", "Action": ["kms:GenerateDataKey"], "Resource": { "Ref": "ArchiveKeyArn" }, "Condition": { "StringEquals": { "kms:ViaService": "s3.us-east-1.amazonaws.com", "kms:CallerAccount": "838445019912" }, "StringLike": { "kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::applypack-production-protected-recovery-838445019912/database/*" } } },
          { "Effect": "Allow", "Action": ["kms:Decrypt"], "Resource": { "Ref": "ArchiveKeyArn" }, "Condition": { "StringEquals": { "kms:ViaService": "s3.us-east-1.amazonaws.com", "kms:CallerAccount": "838445019912" }, "StringLike": { "kms:EncryptionContext:aws:s3:arn": "arn:aws:s3:::applypack-production-protected-recovery-838445019912/manifests/*" } } }
        ] }
      }
    },
    "DatabaseWriterRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "applypack-production-database-backup-writer", "Path": "/applypack/production/", "MaxSessionDuration": 3600,
        "PermissionsBoundary": { "Ref": "DatabaseWriterBoundary" }, "ManagedPolicyArns": [{ "Ref": "DatabaseWriterBoundary" }],
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "rolesanywhere.amazonaws.com" }, "Action": ["sts:AssumeRole", "sts:TagSession", "sts:SetSourceIdentity"], "Condition": { "StringEquals": { "aws:SourceAccount": "838445019912", "aws:PrincipalTag/x509Subject/CN": "applypack-production-database-backup-writer" }, "ArnEquals": { "aws:SourceArn": { "Ref": "ProductionTrustAnchorArn" } } } }] },
        "Tags": [{ "Key": "Application", "Value": "ApplyPack" }, { "Key": "Environment", "Value": "production" }, { "Key": "ReleaseSha", "Value": { "Ref": "ReleaseSha" } }, { "Key": "ApprovedQuoteSha256", "Value": { "Ref": "ApprovedQuoteSha256" } }]
      }
    },
    "DatabaseWriterProfile": {
      "Type": "AWS::RolesAnywhere::Profile",
      "Properties": {
        "Name": "applypack-production-database-backup-writer", "Enabled": { "Fn::If": ["DatabaseWriterEnabled", true, false] },
        "DurationSeconds": 3600, "AcceptRoleSessionName": false, "RoleArns": [{ "Fn::GetAtt": ["DatabaseWriterRole", "Arn"] }],
        "Tags": [{ "Key": "Application", "Value": "ApplyPack" }, { "Key": "Environment", "Value": "production" }]
      }
    }
  },
  "Outputs": {
    "DatabaseWriterRoleArn": { "Value": { "Fn::GetAtt": ["DatabaseWriterRole", "Arn"] } },
    "DatabaseWriterProfileArn": { "Value": { "Fn::GetAtt": ["DatabaseWriterProfile", "ProfileArn"] } }
  }
}
