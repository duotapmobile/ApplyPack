# Public browser-safe configuration
NEXT_PUBLIC_APP_URL=https://applypack.work
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_SECRET_KEY=
# Exact production project identity, verified from provider evidence; staging is pinned in code.
APP_EXPECTED_SUPABASE_PROJECT_REF=

# Stripe server-only configuration
STRIPE_SECRET_KEY=
# Non-secret account ID verified using this server key, never inferred from its test/live prefix.
STRIPE_EXPECTED_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_JOB_SEARCH_PRICE_ID=
STRIPE_APPLY_PACK_PRICE_ID=
# Reconciliation/refunds only. Never used to create a new Checkout Session.
STRIPE_LEGACY_JOB_SEARCH_PRICE_ID=
STRIPE_LEGACY_APPLY_PACK_PRICE_ID=
APP_PAYMENT_MODE=disabled
APP_CHECKOUT_ENABLED=false
# Historical compatibility only. Amendment17 disables new production CANARY
# operations; keep false. Use sandbox proof and the genuine customer pilot.
APP_CANARY_CHECKOUT_ENABLED=false
# Only the exact staging host/project and test Stripe accept restricted rehearsal.
APP_REHEARSAL_CHECKOUT_ENABLED=false
# Must be exactly staging or production in a hosted environment.
APP_DEPLOYMENT_ENV=
APP_JOB_BOARD_CHECKOUT_ENABLED=false
# Requires a separate explicit owner approval before any live-mode deployment.
APP_LIVE_PAYMENTS_ENABLED=false
# Enable only after approved hosted retention verification. Required for public launch.
APP_SERVICE_RETENTION_ENABLED=false

# Resend server-only configuration
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=orders@applypack.work
EMAIL_REPLY_TO=help@applypack.work
# Timestamp of the most recent allowlisted provider-backed staging delivery.
APP_EMAIL_DELIVERY_VERIFIED_AT=

# Application policy
APP_DISPLAY_TIMEZONE=America/New_York
APP_SEARCH_CAPACITY_PER_ROLLING_24H=1
APP_APPLY_PACK_CAPACITY_PER_ROLLING_24H=2
# Legacy/unpaid source setting only. New paid one_off_30d_v1 access and family
# retention are fixed by migration087 and accepted terms, not this variable.
APP_SOURCE_DOCUMENT_RETENTION_DAYS=30
APP_CORRECTION_WINDOW_DAYS=3
APP_JOB_FRESHNESS_HOURS=24
APP_JOB_STALE_AFTER_HOURS=72
# Chunk 4 search checkout reservation; exact contract value.
APP_CAPACITY_RESERVATION_MINUTES=30
APP_LEGAL_ENTITY_NAME=DuoTap LLC d/b/a ApplyPack
# Manual launch has no subscription board. Board checkout is hard-disabled in code.
APP_MANUAL_LAUNCH_SCOPE=MANUAL_ONLY
APP_LEGACY_BOARD_MAINTENANCE_ENABLED=false
APP_EXPECTED_RELEASE_SHA=

# Anonymous capability lifetime is separate from paid service retention.
# Leave an unapproved session lifetime blank and keep Checkout disabled.
APP_ANONYMOUS_DRAFT_SESSION_SECONDS=
APP_FILE_PROCESSING_ENABLED=false
APP_MALWARE_SCANNER_IDENTITY=
APP_DOCUMENT_RENDERER_IDENTITY=
APP_LIBREOFFICE_EXECUTABLE=
APP_LIBREOFFICE_EXECUTABLE_SHA256=
APP_PDFINFO_EXECUTABLE=
APP_PDFINFO_EXECUTABLE_SHA256=
APP_PDFFONTS_EXECUTABLE=
APP_PDFFONTS_EXECUTABLE_SHA256=
APP_PDFTOTEXT_EXECUTABLE=
APP_PDFTOTEXT_EXECUTABLE_SHA256=
APP_PDFTOPPM_EXECUTABLE=
APP_PDFTOPPM_EXECUTABLE_SHA256=
APP_PDFTOHTML_EXECUTABLE=
APP_PDFTOHTML_EXECUTABLE_SHA256=
# New artifacts use the complete pinned Liberation Sans 2.1.5 family. Old
# Arial evidence is historical-access-only and is never a generation input.
APP_DOCUMENT_FONT_FILE=
APP_DOCUMENT_FONT_FILE_SHA256=
APP_DOCUMENT_FONT_BOLD_FILE=
APP_DOCUMENT_FONT_BOLD_FILE_SHA256=
APP_DOCUMENT_FONT_ITALIC_FILE=
APP_DOCUMENT_FONT_ITALIC_FILE_SHA256=
APP_DOCUMENT_FONT_BOLD_ITALIC_FILE=
APP_DOCUMENT_FONT_BOLD_ITALIC_FILE_SHA256=
APP_DOCUMENT_FONT_MANIFEST_SHA256=d89582771ff8dde19015f5aa3965810d656f93fcb08cee6280497e780de614bb
APP_SANDBOXED_PARSER_IDENTITY=
APP_DOCUMENT_WORKER_DEPLOYMENT_ENV=
APP_DOCUMENT_WORKER_PREFLIGHT_RECEIPT_SHA256=
APP_DOCUMENT_WORKER_FUNCTION_ARN=
APP_DOCUMENT_WORKER_BUCKET=
APP_DOCUMENT_WORKER_IDENTITY=applypack-document-worker-v2-liberation-sans-2.1.5
APP_DOCUMENT_WORKER_FONT_SHA256=76d04c18ea243f426b7de1f3ad208e927008f961dc5945e5aad352d0dfde8ee8
APP_DOCUMENT_WORKER_FONT_MANIFEST_SHA256=d89582771ff8dde19015f5aa3965810d656f93fcb08cee6280497e780de614bb
APP_DOCUMENT_WORKER_IMAGE_DIGEST=
APP_DOCUMENT_WORKER_NETWORK_ATTESTATION_SHA256=
# Release evidence for the final synthetic probe; not an approval itself.
APP_DOCUMENT_WORKER_PROBE_RECEIPT_SHA256=
# Fixed worker implementation/policy namespace; must remain ephemeral/.
APP_DOCUMENT_WORKER_TEMPORARY_PREFIX=ephemeral/
APP_PARSER_MAX_EXPANDED_BYTES=
APP_PARSER_MAX_PAGES=
APP_PARSER_MAX_MILLISECONDS=
APP_PARSER_MAX_MEMORY_BYTES=
APP_PERMITTED_MODEL_POLICY=
# Separate server-only switches. These do not approve provider spending or
# customer-data transfer; the immutable DB policy/runtime gate is also required.
# The queue remains under integration until stage094 and its adapter are verified.
APP_MATERIAL_DRAFT_QUEUE_ENABLED=false
APP_MATERIAL_DRAFTING_ENABLED=false
APP_MATERIAL_DRAFT_RENDERING_ENABLED=false
OPENAI_API_KEY=
APP_CUSTOMER_SUPPLIED_JOBS_ENABLED=false
APP_SENSITIVE_PAYLOAD_ENCRYPTION_ENABLED=false
# aws uses the standard AWS credential chain and an immutable key ARN.
APP_KMS_PROVIDER=aws
AWS_REGION=us-east-1
# Hosted AWS caller uses the pinned Roles Anywhere helper and separate environment identity.
# Seal leaf values only into the named service. Never store a CA private key here.
APP_AWS_ACCOUNT_ID=
APP_AWS_RA_DEPLOYMENT_ENV=
APP_AWS_RA_TRUST_ANCHOR_ARN=
APP_AWS_RA_PROFILE_ARN=
APP_AWS_RA_ROLE_ARN=
APP_AWS_RA_HELPER_PATH=
APP_AWS_RA_CERTIFICATE_PEM_BASE64=
APP_AWS_RA_PRIVATE_KEY_PEM_BASE64=
APP_AWS_RA_CA_CERTIFICATE_PEM_BASE64=
APP_AWS_RA_CERTIFICATE_SHA256=
APP_AWS_RA_CA_CERTIFICATE_SHA256=
APP_KMS_KEY_IDENTITY=
APP_KMS_KEY_VERSION=
APP_KMS_ENCRYPTION_CONTEXT_VERSION=
# Remote KMS variables are nonproduction compatibility only and are rejected in production.
APP_KMS_WRAP_URL=
APP_KMS_UNWRAP_URL=
APP_KMS_BEARER_TOKEN=
APP_KMS_TIMEOUT_MS=10000

# Legacy compatibility scanner. document_validation is structural validation,
# never a malware-clean verdict for the corrected processing pipeline.
APP_FILE_SCAN_MODE=document_validation
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
APP_ADMIN_ALERT_EMAIL=admin@applypack.work
APP_ADMIN_EMAILS=
APP_SAFE_TEST_EMAILS=

# Official job-source synchronization (server-side only; no source credentials)
APP_JOB_SOURCE_SYNC_ENABLED=false
APP_JOB_SOURCE_WORKER_ID=
APP_JOB_SOURCE_TIMEOUT_MS=10000
APP_JOB_SOURCE_MIN_INTERVAL_MS=1500
# Required approved production bounds have no default. Leave blank until the
# documentary source authorization and matching configuration are approved.
APP_JOB_SOURCE_MAX_POSTINGS=
APP_RELEASE_VERIFICATION_TTL_SECONDS=3600
APP_FEASIBILITY_SOURCE_MATRIX_JSON=
APP_MATCHING_RULES_VERSION=matching-rules-v1
APP_JOB_SOURCE_USER_AGENT=ApplyPackSourceMonitor/1.0 (+https://applypack.work/contact)

# Fictional board data is permitted only in a non-production staging environment.
# The seed command also refuses the production domain, live payments, and any
# Railway environment whose name is not exactly staging.
APP_STAGING_SYNTHETIC_JOBS=false
APP_ALLOW_SYNTHETIC_SEED=false
APP_BOARD_WORKER_ID=

# Scheduled jobs and monitoring
CRON_SECRET=
APP_MAINTENANCE_URL=
# Launch profile: every 15 minutes; fail stale after three missed intervals.
APP_MAINTENANCE_MAX_AGE_MINUTES=45
ERROR_MONITORING_DSN=
# Independent read-only observer; separate from CRON_SECRET and archive credentials.
# Configure only after the consolidated quote and hosted setup approval.
APP_OPERATIONS_MONITOR_ENABLED=false
APP_OPERATIONS_MONITOR_SECRET=
# Protected archive lifecycle: local implementation is not hosted activation.
# All three controls stay false until quote, identities, writer retirement and
# exact hosted execution are approved and independently verified.
APP_ARCHIVE_LIFECYCLE_ENABLED=false
APP_ARCHIVE_VERIFICATION_ENABLED=false
APP_ARCHIVE_RETENTION_EXECUTION_ENABLED=false
APP_DATABASE_BACKUP_LIFECYCLE_SECRET=
# Separate unattended verifier. Never use the human MFA disaster-recovery role.
# APP_BACKUP_KMS_KEY_ARN identifies the existing reviewed archive key.
APP_BACKUP_KMS_KEY_ARN=
APP_ARCHIVE_VERIFIER_AWS_RA_DEPLOYMENT_ENV=
APP_ARCHIVE_VERIFIER_AWS_RA_TRUST_ANCHOR_ARN=
APP_ARCHIVE_VERIFIER_AWS_RA_PROFILE_ARN=
APP_ARCHIVE_VERIFIER_AWS_RA_ROLE_ARN=
APP_ARCHIVE_VERIFIER_AWS_RA_HELPER_PATH=
APP_ARCHIVE_VERIFIER_AWS_RA_CERTIFICATE_PEM_BASE64=
APP_ARCHIVE_VERIFIER_AWS_RA_PRIVATE_KEY_PEM_BASE64=
APP_ARCHIVE_VERIFIER_AWS_RA_CA_CERTIFICATE_PEM_BASE64=
APP_ARCHIVE_VERIFIER_AWS_RA_CERTIFICATE_SHA256=
APP_ARCHIVE_VERIFIER_AWS_RA_CA_CERTIFICATE_SHA256=
# Leave blank until a scheduled worker is explicitly configured. This does not
# approve or activate Stripe, Resend, or any source provider.
APP_CHUNK4_WORKER_ID=

# Hidden research projection only; does not verify or publish jobs.
APP_JOB_SOURCE_PROJECTION_ENABLED=false

# Opt-in Linux executable and exact Liberation Sans 2.1.5 family discovery;
# does not approve document delivery.
APP_RENDERER_RUNTIME_DISCOVERY=false
