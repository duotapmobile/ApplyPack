{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "node --check scripts/run-maintenance-once.mjs"
  },
  "deploy": {
    "startCommand": "node scripts/run-maintenance-once.mjs",
    "cronSchedule": "*/15 * * * *",
    "healthcheckPath": null,
    "restartPolicyType": "NEVER"
  }
}
