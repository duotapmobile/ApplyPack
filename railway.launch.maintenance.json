{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.launch"
  },
  "deploy": {
    "startCommand": "node scripts/run-maintenance-once.mjs",
    "cronSchedule": "*/15 * * * *",
    "healthcheckPath": null,
    "restartPolicyType": "NEVER"
  }
}
