# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM golang:1.26.10-bookworm@sha256:88750ccdd0f2a77fcc00a14b1a48d6409bd8ddb5d7c2dd6ec0b4a2e916daf9d9 AS signing-helper-build
WORKDIR /helper-build
COPY infra/aws/roles-anywhere-helper/ /helper-build/
RUN bash /helper-build/build.sh prepare
RUN --network=none bash /helper-build/build.sh compile

FROM node:22-bookworm-slim@sha256:ea11b74b986d520137cdef9a5346e447a00f275ecc4abc0055b7151226231e09 AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# Official PostgreSQL 17.11 AMD64 image, pinned independently from the web image.
# Keep package metadata so the entire runtime remains visible to vulnerability scans.
FROM postgres:17-trixie@sha256:3518071376d0b6156b02e1db2747a78511b5b9dc3763cc79c506ebe2dc2ee71c AS database-recovery
WORKDIR /app
COPY --from=dependencies /usr/local/bin/node /usr/local/bin/node
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/package.json /app/package-lock.json ./
COPY --from=signing-helper-build /out/aws_signing_helper /usr/local/bin/aws_signing_helper
COPY --from=signing-helper-build /out/provenance /usr/share/applypack/signing-helper/provenance
COPY --from=signing-helper-build /out/licenses /usr/share/applypack/signing-helper/licenses
COPY scripts/lib/ ./scripts/lib/
COPY scripts/run-database-recovery.mjs ./scripts/run-database-recovery.mjs
COPY docs/launch/database-recovery-targets.json ./docs/launch/database-recovery-targets.json
COPY infra/database-recovery/runtime-manifest.json /opt/applypack/database-recovery-runtime.json
RUN node --input-type=module -e "import fs from 'node:fs'; import crypto from 'node:crypto'; const p=JSON.parse(fs.readFileSync('/opt/applypack/database-recovery-runtime.json')); for(const [name,key] of [['psql','psqlSha256'],['pg_dump','pgDumpSha256']]) { const digest=crypto.createHash('sha256').update(fs.readFileSync('/usr/lib/postgresql/17/bin/'+name)).digest('hex'); if(digest!==p[key]) throw new Error('DATABASE_RECOVERY_CLIENT_DIGEST'); }"
ENV NODE_ENV=production HOME=/tmp APP_DATABASE_BACKUP_ENABLED=false
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/node", "scripts/run-database-recovery.mjs"]
CMD []
